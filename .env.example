# Supabase — Settings → API (project URL + keys)
# Safe to expose in the browser (used as the project URL everywhere).
NEXT_PUBLIC_SUPABASE_URL=

# Service role: .env.local / Vercel server env only — do not commit, do not use NEXT_PUBLIC_.
# Route Handlers (Step 5) use this for CRUD scoped by user_id from the session.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: browser Supabase client + RLS later; can stay empty for now.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NextAuth (Auth.js v5) — https://authjs.dev
# Generate secret: openssl rand -base64 32
AUTH_SECRET=
# Local dev URL; production: your Vercel URL
AUTH_URL=http://localhost:3000
# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
