# Supabase — Settings → API (project URL + keys)
# Safe to expose in the browser (used as the project URL everywhere).
NEXT_PUBLIC_SUPABASE_URL=

# Service role: .env.local / Vercel server env only — do not commit, do not use NEXT_PUBLIC_.
# Route Handlers (Step 5) use this for CRUD scoped by user_id from the session.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: browser Supabase client + RLS later; can stay empty for now.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
