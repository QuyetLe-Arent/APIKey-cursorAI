# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# editor / local IDE (uncomment if you want shared .vscode in the repo)
# .vscode/
# .idea/

# tool caches
.eslintcache
.prettiercache

# Supabase CLI (local `supabase start`)
supabase/.branches
supabase/.temp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — avoid a blanket `.env*` rule (it can ignore `.env.example`, which should stay committed)
.env
.env*.local

# vercel
.vercel

# AI-generated local docs (not committed)
/my_docs/

# typescript
*.tsbuildinfo
next-env.d.ts
